<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ForceAutoHDR.App.AddGamesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ForceAutoHDR.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ForceAutoHDR.App.ViewModels"
    Title="Add games"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
    Opened="OnOpened"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Add"
    mc:Ignorable="d">

    <!--
        The default dialog is narrower than the content needs: a full executable path plus a date
        does not fit, and anything past the theme's own max width is silently clipped rather than
        wrapped, so the width has to be raised here before the Grid can ask for it.
    -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="680" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap">
            <Run Text="These are the executables Windows has recorded as games, which is not always the one a store launches." />
            <Run Text="The list is Windows' own, so the odd non-game shows up here too." />
        </TextBlock>

        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.Name="Detect the running game"
                    Click="OnDetectRunningClick"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    ToolTipService.ToolTip="Samples the GPU counters to find what is rendering right now. Runs once by itself when this dialog opens; press it again after starting a game.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.IsProbing, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ProbeRingVisibility, Mode=OneWay}" />
                        <TextBlock Text="Detect running game" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Browse for an executable"
                    Click="OnBrowseClick"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    ToolTipService.ToolTip="Pick the executable yourself">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8DA;" />
                        <TextBlock Text="Browse…" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--
                Windows records a game only when it matches a list Microsoft ships, so a game
                installed outside the layout that list expects never reaches this dialog at all;
                see notes/gamebar-matches-games-against-a-microsoft-list.md. An absence tells the
                user nothing, and neither way out is discoverable, so both are spelled out here
                rather than hidden in a tooltip nobody hovers.
            -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap">
                <Run Text="Game missing? Windows recognises games from a list it downloads, and one installed outside the folders that list expects is never recorded — moving a game between a store and its own launcher is enough." />
                <Run Text="Start it and press Detect running game, or fix it for good in Win+G → Settings → General → “Remember this is a game”." />
            </TextBlock>
        </StackPanel>

        <InfoBar
            x:Name="MessageBar"
            Grid.Row="2"
            IsOpen="False"
            Severity="Informational" />

        <!--
            Horizontal scrolling off: paths are long enough to push the date column out of the
            dialog entirely, and an ellipsis on the path costs nothing since the tooltip has it in
            full.
        -->
        <ListView
            Grid.Row="3"
            MaxHeight="320"
            Padding="0"
            ItemsSource="{x:Bind ViewModel.Candidates}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <!--  Extra room on the right so the date clears the scrollbar.  -->
                    <Setter Property="Padding" Value="8,4,16,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:GameCandidateViewModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition MinWidth="112" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind DisplayName}"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ExecutablePath}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind ExecutablePath}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <!--  A running game is the one piece of hard evidence in this list.  -->
                            <Border
                                Padding="6,1"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind RunningBadgeVisibility, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Running" />
                            </Border>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind LastPlayedText, Mode=OneWay}"
                                Visibility="{x:Bind LastPlayedVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Nothing left to add." />
            <TextBlock
                HorizontalAlignment="Center"
                MaxWidth="420"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Everything Windows has recorded is already configured. Start a game and use Detect running game, or browse for its executable." />
        </StackPanel>
    </Grid>
</ContentDialog>
