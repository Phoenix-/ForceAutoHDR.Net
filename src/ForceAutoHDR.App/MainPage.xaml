<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ForceAutoHDR.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ForceAutoHDR.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ForceAutoHDR.App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="20,4,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title, the one paragraph of explanation this domain needs, and the commands.  -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel MaxWidth="620" HorizontalAlignment="Left" Spacing="2">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Configured games" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap">
                    <Run Text="Auto HDR is the per-game switch from Windows Settings." />
                    <Run Text="Force upgrades the game's swapchain to 10-bit so Auto HDR engages for titles Windows will not offer it for." />
                    <Run Text="Both apply the next time the game starts." />
                </TextBlock>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="AddGameButton"
                    AutomationProperties.Name="Add game"
                    Click="OnAddGameClick"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add game" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Refresh"
                    Click="OnRefreshClick"
                    ToolTipService.ToolTip="Re-read the registry">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ErrorBar"
                IsOpen="False"
                Severity="Error" />

            <!--  Windows never prunes these itself, so nothing else will ever offer to.  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.StaleMessage, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind ViewModel.StaleBarVisibility, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Click="OnCleanUpStaleClick"
                        Content="Remove them"
                        ToolTipService.ToolTip="Deletes their per-app Auto HDR entries. Any Force override is kept, since it matches on file name and another install may still need it." />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!--  Column headers. Widths are mirrored by the item template below.  -->
        <Grid
            Grid.Row="2"
            Margin="0,4,0,-4"
            Padding="12,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Game" />
            <TextBlock
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Auto HDR" />
            <TextBlock
                Grid.Column="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Force" />
        </Grid>

        <ListView
            Grid.Row="3"
            Padding="0"
            ItemsSource="{x:Bind ViewModel.Profiles}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileViewModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind PathText}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind PathText}" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Auto HDR"
                            IsEnabled="{x:Bind HasPath}"
                            IsOn="{x:Bind IsAutoHdrEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent=""
                            ToolTipService.ToolTip="{x:Bind AutoHdrTooltip}" />

                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Force"
                            IsOn="{x:Bind IsForced, Mode=TwoWay}"
                            OffContent=""
                            OnContent=""
                            ToolTipService.ToolTip="Forces the 10-bit swapchain upgrade. Matches on the file name, so every install of this executable is affected." />

                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="Remove"
                            Click="{x:Bind Remove}"
                            ToolTipService.ToolTip="Remove both settings, leaving the game unconfigured">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE7F4;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="No games are configured yet." />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Add game lists what Windows has already seen you play." />
        </StackPanel>
    </Grid>
</Page>
